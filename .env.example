# Local development settings. Placeholders only: never put a real secret in this file.
# scripts/setup.sh copies this file and fills every empty secret (and each __NAME__ placeholder)
# with a fresh random value. It never overwrites an existing local file.

# Postgres (docker/compose.dev.yml). The superuser is used only by the container's init scripts.
POSTGRES_PASSWORD=
DMS_OWNER_PASSWORD=
DMS_APP_PASSWORD=
# Migrations, seeds and test setup connect as dms_owner; the app connects as dms_app (NOBYPASSRLS).
DATABASE_URL_OWNER=postgres://dms_owner:__DMS_OWNER_PASSWORD__@127.0.0.1:5432/dms
DATABASE_URL_APP=postgres://dms_app:__DMS_APP_PASSWORD__@127.0.0.1:5432/dms

# MinIO (S3 API). Root credentials are for docker/minio/init.sh only; the app uses S3_ACCESS_KEY.
MINIO_ROOT_USER=dms-root
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=dms-records
S3_ACCESS_KEY=dms-app
S3_SECRET_KEY=

# Field-encryption master key: base64 of 32 random bytes.
MASTER_KEY=

# Entitlements: public key used to verify license keys (no private key is ever stored here).
LICENSE_PUBLIC_KEY_PATH=packages/entitlements/keys/public.pem

DMS_WEB_ORIGIN=http://localhost:5173
DMS_LOG_LEVEL=info
